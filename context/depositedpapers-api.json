            "nullable": true,
            "example": "2019-01-01"
          },
          "dateOfOrigin": {
            "pattern": "\\d{4}(-|/)\\d{2}(-|/)\\d{2}((T|t)\\d{2}:\\d{2}:\\d{2})?",
            "type": "string",
            "nullable": true,
            "example": "2019-01-01"
          },
          "dateOfCommitmentToDeposit": {
            "pattern": "\\d{4}(-|/)\\d{2}(-|/)\\d{2}((T|t)\\d{2}:\\d{2}:\\d{2})?",
