{
  "openapi": "3.0.1",
  "info": {
    "title": "Deposited papers API",
    "description": "Find and Retrieve Deposited Papers.",
    "contact": {
      "name": "UK Parliament",
      "url": "https://www.parliament.uk",
      "email": "softwareengineering@parliament.uk"
    },
    "version": "v1"
  },
  "paths": {
    "/api/DepositedPapers": {
      "get": {
        "tags": [
          "DepositedPapers"
        ],
        "summary": "Returns a list of deposited papers.",
        "operationId": "SearchDepositedPapers",
        "parameters": [
          {
            "name": "DepositedFrom",
            "in": "query",
            "description": "Deposited papers with deposited date after date specified. Expected format is yyyy-MM-dd",
            "schema": {
              "pattern": "\\d{4}(-|/)\\d{2}(-|/)\\d{2}((T|t)\\d{2}:\\d{2}:\\d{2})?",
              "type": "string",
              "example": "2019-01-01"
            }
          },
          {
            "name": "DepositedTo",
            "in": "query",
            "description": "Deposited papers with deposited date before date specified. Expected format is yyyy-MM-dd",
            "schema": {
              "pattern": "\\d{4}(-|/)\\d{2}(-|/)\\d{2}((T|t)\\d{2}:\\d{2}:\\d{2})?",
              "type": "string",
              "example": "2019-01-01"
            }
          },
          {
            "name": "House",
            "in": "query",
            "description": "Deposited papers relating to the House specified",
            "schema": {
              "$ref": "#/components/schemas/House"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "description": "Search result ordering option",
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "name": "Terms",
            "in": "query",
            "description": "Deposited papers containing term specified, which can relate to depositing department, paper number and summary.",
            "schema": {
              "maxLength": 500,
              "minLength": 2,
              "type": "string"
            }
          },
          {
            "name": "DepartmentSesId",
            "in": "query",
            "description": "Deposited papers with specified depositing department\r\nGet department list from http://data.parliament.uk/membersdataplatform/services/mnis/ReferenceData/Departments",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Skip",
            "in": "query",
            "description": "Number of records to skip, default is 0",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Take",
            "in": "query",
            "description": "Number of records to take, default is 20",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperSummaryResourceCollection"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperSummaryResourceCollection"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperSummaryResourceCollection"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/DepositedPapers/{paperId}": {
      "get": {
        "tags": [
          "DepositedPapers"
        ],
        "summary": "Returns a deposited paper by ID.",
        "operationId": "GetDepositedPaper",
        "parameters": [
          {
            "name": "paperId",
            "in": "path",
            "description": "Deposited paper by ID specified",
            "required": true,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperDetailResource"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperDetailResource"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositedPaperDetailResource"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
